{
  "name": "@platejs/plite-outliner",
  "version": "54.0.0-beta.0",
  "private": true,
  "description": "Generic tree-outliner transactions for Plite.",
  "keywords": [
    "editor",
    "outline",
    "outliner",
    "plite",
    "tree"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/plate.git",
    "directory": "packages/plite-outliner"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "brl": "echo 'No barrels to generate'",
    "build": "tsdown --config tsdown.config.mts --log-level warn",
    "clean": "rimraf dist lib",
    "lint": "plate-pkg p:lint",
    "lint:fix": "plate-pkg p:lint:fix",
    "test": "bun test --preload ../../config/plite-source-test-setup.ts",
    "typecheck": "plate-pkg p:typecheck"
  },
  "dependencies": {
    "@platejs/dnd": "workspace:^"
  },
  "devDependencies": {
    "@plate/scripts": "workspace:*",
    "@platejs/plite": "workspace:^",
    "@types/react": "19.2.7",
    "react": "19.2.8"
  },
  "peerDependencies": {
    "@platejs/plite": ">=54.0.0-beta.0",
    "react": ">=18"
  }
}
